{
  // 言語サーバに tsrs（Rust 製の TypeScript 移植版）を使う。tsrs は tsgo と同じ LSP を話すので、
  // 拡張「TypeScript (Native Preview)」の tsdk に node_modules/tsrs/tsdk を指す。
  // 要: 拡張のインストールと、初回のワークスペース信頼・SDK 実行の許可。
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/tsrs/tsdk",

  // Code Spell Checker（cSpell）にプロジェクト固有語を登録してノイズを抑制。
  "cSpell.words": [
    "BAKUNE",
    "esbuild",
    "frontmatter",
    "funstack",
    "Kaigi",
    "napi",
    "pnpm",
    "shiki",
    "takumi",
    "tsbuildinfo",
    "tsconfig",
    "tsrs",
    "tsuka",
    "uhyo"
  ]
}
