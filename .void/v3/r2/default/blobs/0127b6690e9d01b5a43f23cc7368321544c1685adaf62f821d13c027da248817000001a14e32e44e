n":96,"offset":1517}}},{"type":"inlineCode","value":"fract","position":{"start":{"line":40,"column":96,"offset":1517},"end":{"line":40,"column":103,"offset":1524}}},{"type":"text","value":"で空間を繰り返す……という基本動作を積み上げていく感じ。","position":{"start":{"line":40,"column":103,"offset":1524},"end":{"line":40,"column":131,"offset":1552}}}],"position":{"start":{"line":40,"column":1,"offset":1422},"end":{"line":40,"column":131,"offset":1552}}},{"type":"paragraph","children":[{"type":"text","value":"前半はあんまりピンとこなかったが、「パターン」や「ノイズ」がいくつかでてうねうね動き始めてからは楽しかった。後半は乱数→ノイズ→fBm と抽象度が上がって、雲や煙みたいな揺らぎに繋がっていく。何をしているか理解するのは大変だけど、実装量も多くないのも良い。","position":{"start":{"line":42,"column":1,"offset":1554},"end":{"line":42,"column":129,"offset":1682}}}],"position":{"start":{"line":42,"column":1,"offset":1554},"end":{"line":42,"column":129,"offset":1682}}},{"type":"paragraph","children":[{"type":"text","value":"時間はかかったけどかなりシェーダーについてのメンタルモデルを獲得できた気がする。良書です。","position":{"start":{"line":44,"column":1,"offset":1684},"end":{"line":44,"column":46,"offset":1729}}}],"position":{"start":{"line":44,"column":1,"offset":1684},"end":{"line":44,"column":46,"offset":1729}}},{"type":"paragraph","children":[{"type":"text","value":"「楽しい！Unityシェーダーお絵描き入門！」も復習的な内容だけど概念を整理してくれていて助かる。BoSはどっちかというと流れで読むので冗長に感じる部分がなくはないからだ。","position":{"start":{"line":46,"column":1,"offset":1731},"end":{"line":46,"column":87,"offset":1817}}}],"position":{"start":{"line":46,"column":1,"offset":1731},"end":{"line":46,"column":87,"offset":1817}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"The Study of Shaders with React Three Fiber","position":{"start":{"line":48,"column":5,"offset":1823},"end":{"line":48,"column":48,"offset":1866}}}],"position":{"start":{"line":48,"column":1,"offset":1819},"end":{"line":48,"column":48,"offset":1866}},"id":"the-study-of-shaders-with-react-three-fiber"},{"type":"paragraph","children":[{"type":"text","value":"本来R3Fでシェーダーをやる話だけど、WGSLに置き換えながら読んだ。","position":{"start":{"line":50,"column":1,"offset":1868},"end":{"line":50,"column":36,"offset":1903}}}],"position":{"start":{"line":50,"column":1,"offset":1868},"end":{"line":50,"column":36,"offset":1903}}},{"type":"paragraph","children":[{"type":"text","value":"色の計算に閉じていたBoSと違って、こっちは「JS側でメッシュを用意して、attribute/uniform/varyingでデータをシェーダーに渡す」という繋ぎ込みの全体像が見える。頂点を動かして→色を塗る、という往復が見えたことで、Fundamentalsのパイプラインの話とBoSの絵作りが1本に繋がった感じがあった。","position":{"start":{"line":52,"column":1,"offset":1905},"end":{"line":52,"column":163,"offset":2067}}}],"position":{"start":{"line":52,"column":1,"offset":1905},"end":{"line":52,"column":163,"offset":2067}}},{"type":"paragraph","children":[{"type":"text","value":"これを最初に読んでも良いかも、というくらいまとまっていて面白かった。この人の記事は他にも読みたいものがいくつかある。","position":{"start":{"line":54,"column":1,"offset":2069},"end":{"line":54,"column":59,"offset":2127}}}],"position":{"start":{"line":54,"column":1,"offset":2069},"end":{"line":54,"column":59,"offset":2127}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"シェーダだけで世界を創る！three.jsによるレイマーチング","position":{"start":{"line":56,"column":5,"offset":2133},"end":{"line":56,"column":36,"offset":2164}}}],"position":{"start":{"line":56,"column":1,"offset":2129},"end":{"line":56,"column":36,"offset":2164}},"id":"シェーダだけで世界を創るthreejsによるレイマーチング"},{"type":"paragraph","children":[{"type":"text","value":"レイマーチングの概要をつかむために読んだ。距離関数(SDF)でシーンを定義して、レイを少しずつ前進させながら衝突を探す……（この文章自体もAIに書いてもらったがよくわからん）というのが骨子らしい。補足してもらいつつだけどまだ腹落ちしてない感じはある。","position":{"start":{"line":58,"column":1,"offset":2166},"end":{"line":58,"column":126,"offset":2291}}}],"position":{"start":{"line":58,"column":1,"offset":2166},"end":{"line":58,"column":126,"offset":2291}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"wgld.org / GLSL","position":{"start":{"line":60,"column":5,"offset":2297},"end":{"line":60,"column":20,"offset":2312}}}],"position":{"start":{"line":60,"column":1,"offset":2293},"end":{"line":60,"column":20,"offset":2312}},"id":"wgldorg-glsl"},{"type":"paragraph","children":[{"type":"text","value":"GLSL全般の連載。ノイズやフラクタル、レイマーチング、ライティングまで一通り扱っている。レイマーチングの回はこれから読むところだけど、その前段のマンデルブロ集合やジュリア集合が書けたのは新鮮だった。やっぱフラクタルはやってみたかったことのうちの一つなのでね。","position":{"start":{"line":62,"column":1,"offset":2314},"end":{"line":62,"column":131,"offset":2444}}}],"position":{"start":{"line":62,"column":1,"offset":2314},"end":{"line":62,"column":131,"offset":2444}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"シェーダーに対するメンタルモデル","position":{"start":{"line":64,"column":4,"offset":2449},"end":{"line":64,"column":20,"offset":2465}}}],"position":{"start":{"line":64,"column":1,"offset":2446},"end":{"line":64,"column":20,"offset":2465}},"id":"シェーダーに対するメンタルモデル"},{"type":"paragraph","children":[{"type":"text","value":"シェーダーを理解する上で一番大切なのは、GPUによる並列処理だということっぽい。","position":{"start":{"line":66,"column":1,"offset":2467},"end":{"line":66,"column":41,"offset":2507}}}],"position":{"start":{"line":66,"column":1,"offset":2467},"end":{"line":66,"column":41,"offset":2507}}},{"type":"paragraph","children":[{"type":"text","value":"頂点シェーダーが頂点ごとに位置を、フラグメントシェーダーがピクセルごとに色を、それぞれ並列で計算する。左右のピクセルから情報や状態を引き回したりはなるべくしなくても済むのが良い。だからこそ超高速に計算してレンダリングされるし、逆に各点に対する計算コストが高いレイマーチングなんかは描画も重くて大変。","position":{"start":{"line":68,"column":1,"offset":2509},"end":{"line":68,"column":150,"offset":2658}}}],"position":{"start":{"line":68,"column":1,"offset":2509},"end":{"line":68,"column":150,"offset":2658}}},{"type":"paragraph","children":[{"type":"text","value":"どうやらライフゲームみたいに「隣のセルを参照して状態を次のフレームに持ち越す」やつは、この並列前提から少しはみ出るっぽい。とはいえ逐次処理になるわけではなくて、各セルは相変わらず並列で計算される。前フレームの状態をテクスチャに焼き付けて読み直す（ping-pong）か、コンピュートシェーダーを使うか、みたいな話らしい。まだちゃんとわかってない。","position":{"start":{"line":70,"column":1,"offset":2660},"end":{"line":70,"column":174,"offset":2833}}}],"position":{"start":{"line":70,"column":1,"offset":2660},"end":{"line":70,"column":174,"offset":2833}}},{"type":"paragraph","children":[{"type":"text","value":"それぞれは純粋関数、というかインプットに対して純粋な数式で計算されるのは関数型っぽいことが好きな身としては馴染む感じがあった。Randomのあたりで疑似乱数（ハッシュ）を使って決定論的にランダムっぽい値を作るのも良いね。それ以降にも登場するテクニックだっ