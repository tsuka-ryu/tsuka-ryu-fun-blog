"column":20,"offset":2019}}}],"position":{"start":{"line":78,"column":1,"offset":2000},"end":{"line":78,"column":20,"offset":2019}}}],"position":{"start":{"line":8,"column":1,"offset":105},"end":{"line":79,"column":1,"offset":2020}}},"toc":[{"depth":2,"text":"ご挨拶","id":"ご挨拶"},{"depth":2,"text":"FumadocsとPaper shaders","id":"fumadocsとpaper-shaders"},{"depth":3,"text":"Fumadocs","id":"fumadocs"},{"depth":3,"text":"Paper shaders","id":"paper-shaders"},{"depth":3,"text":"ホスティング・インフラ","id":"ホスティングインフラ"},{"depth":2,"text":"取り上げたいトピック","id":"取り上げたいトピック"},{"depth":3,"text":"フロントエンドエコシステム関連","id":"フロントエンドエコシステム関連"},{"depth":3,"text":"マネージメント、組織論","id":"マネージメント組織論"},{"depth":3,"text":"その他","id":"その他"},{"depth":2,"text":"今後の抱負","id":"今後の抱負"}],"body":"## ご挨拶\n\nこんにちは、tsuka-ryuと申します。2025年も残すところあと2日となりました。早いものですね。今年はどんな一年だったでしょうか。\n\nシンプルではありますが、この度、個人ブログを作ってみました。これまでも何度も作ろうと試みてきたのですが、追加したい機能に対して手が追いつかず、Vibe Codingで勢いよく作っても、レビューをしないでマージすると途中で破綻したり、満足いくものが出来ませんでした。\n\nですが、今回は欲しかった機能は一揃いあるし、かっちょいいシェーダーライブラリも導入してそれっぽくなったので満足してます。今後ぼちぼちブログを書いたり、このブログを盆栽代わりにしていけたら良いなと思っています。\n\nどうぞよろしくお願い致します。\n\n## FumadocsとPaper shaders\n\n### Fumadocs\n\nこのサイトは[Fumadocs](https://www.fumadocs.dev/)というドキュメンテーションフレームワークをベースにNext.jsで作成しています。作者の[Fuma Nama](https://x.com/fuma_nama)氏による美しいデザイン、複数のフレームワークを選択できる柔軟さ、カスタマイズ性の高さ、簡単に追加できる機能の豊富さが特徴です。\n\nあと[Clerk TOC](https://www.fuma-nama.dev/blog/svg-art)もかっこよくて、つい見出しを増やしたくなりますね。\n\nドキュメントもしっかりしているので車輪の再発明を回避しつつ、やりたいことをすぐに実現できました。このブログ自体もデザインがない状態から、2、3日ほどで作成しました。本当にありがたいことですね。\n\n### Paper shaders\n\n[Paper shaders](https://shaders.paper.design/)はFumadocs公式のHero部分で使われていたもので、_ultra fast zero-dependency shaders for your designs_ らしいです。最高ですね。\n\nサイト上で数値をいじいじして、生成されたコンポーネントを貼り付けて最終調整をしたらいい感じになってかなり気に入っています。\n\n### ホスティング・インフラ\n\nホスティングは楽なので一旦Vercelにしていますが、そのうちAWSに載せ替えて、ドメインも取得したいところです。\n\n## 取り上げたいトピック\n\n個人ブログなので好きなことについてひっそり書きたいです。おおまかに以下のようなトピックが書けたらと思います。\n\n### フロントエンドエコシステム関連\n\n- React/Next.js/TypeScriptを中心に、今年注目されたVoid Zero周り、linterやformatterなど\n- おもしろいライブラリがあったら遊ぶとか\n- HTML/CSS/JSのWeb標準周りの動向\n- 記事やpodcastの感想もちらしの裏的に書けたら良いかも\n\n### マネージメント、組織論\n\n- 効果的にマネジメントしたいという気持ちなので、その辺りの雑感\n- どうやって良い組織を作っていくか\n- 読んだ本の感想\n\n### その他\n\n- FigmaやLLM関連\n- アルゴリズムとデータ構造を勉強したいのでそこらへん\n- HaskellやRustにも挑戦したい（願望）\n\n## 今後の抱負\n\n2024年頃までは業務でコードを書く機会がそれなりにあったのですが、今年に入ってからはあまりコードを書かなくなってきたので若干危機感がありました。2026年もおそらく似たような状態になることが予想されます。\n\nいくつかのカンファレンスに初めて参加したり、登壇させていただいたり、刺激はかなりもらえたんですけどね。\n\n一方で、自分の技術力はまだまだ足りないと感じることが多く、もっとコードを書いてたくさんのことを知りたいと思っています。なので、今後はこのサイトをいじったり、記事を書いたりしてアウトプットする機会を増やしていきたいと考えています。\n\n月一くらいで記事が書けたらいいなあ、くらいな感じでしょうか。\n三日坊主がちな人間なのですぐに諦めるかもしれませんが、半年に一回でもいいから書きたいなと思っています。\n\n普段RSSでたくさんの方の個人ブログを読んでいて、なんだか羨ましく感じていたので、自分も似たようなことをしたいだけなんですけどね。\n\nそれでは、良いお年を。\n\n---\n\n_最終更新: 2025年12月30日_\n"}