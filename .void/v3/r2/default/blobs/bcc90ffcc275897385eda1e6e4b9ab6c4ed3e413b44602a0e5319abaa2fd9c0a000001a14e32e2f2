ultiply => BinaryOp::Multiply,\n            other => unreachable!(\"infix_bp が Some を返したのに対応してない: {other:?}\"),\n        };\n        lhs = Expression::Binary {\n            left: Box::new(lhs),\n            op,\n            right: Box::new(rhs),\n        };\n    }\n\n    // PART 6\n    lhs\n}\n","position":{"start":{"line":43,"column":1,"offset":1848},"end":{"line":91,"column":4,"offset":2936}},"lang":"rust","highlight":{"lines":[[{"content":"// 結合力の定義","htmlStyle":{"--shiki-light":"#6A737D","--shiki-dark":"#6A737D"}}],[{"content":"fn","htmlStyle":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"}},{"content":" ","htmlStyle":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},{"content":"infix_bp","htmlStyle":{"--shiki-light":"#6F42C1","--shiki-dark":"#B392F0"}},{"content":"(","htmlStyle":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},{"content":"&","htmlStyle":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"}},{"content":"self","htmlStyle":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},{"content":", tok","htmlStyle":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},{"content":":","htmlStyle":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"}},{"content":" ","htmlStyle":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},{"content":"&","htmlStyle":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"}},{"content":"Token","htmlStyle":{"--shiki-light":"#6F42C1","--shiki-dark":"#B392F0"}},{"content":") ","htmlStyle":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},{"content":"->","htmlStyle":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"}},{"content":" ","htmlStyle":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},{"content":"Option","htmlStyle":{"--shiki-light":"#6F42C1","--shiki-dark":"#B392F0"}},{"content":"<(","htmlStyle":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},{"content":"u8","htmlStyle":{"--shiki-light":"#6F42C1","--shiki-dark":"#B392F0"}},{"content":", ","htmlStyle":{"--shiki-light":"#24292E","--shiki-dark"