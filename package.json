{
  "name": "tsuka-ryu-funstack-blog",
  "version": "1.0.0",
  "private": true,
  "description": "A tech blog on Void + Cloudflare (Workers, D1, R2).",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "vite build && vite preview --host",
    "design": "vite design --config design/vite.config.ts --open",
    "typecheck": "void prepare && tsgo --noEmit && tsgo --noEmit -p vrt && tsgo --noEmit -p scripts",
    "test": "vitest run",
    "test:browser": "vitest run --config vrt/vitest.parse.config.ts",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "test:vrt": "vitest run --config vrt/vitest.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "@paper-design/shaders-react": "0.0.76",
    "@takumi-rs/helpers": "^2.14.0",
    "@takumi-rs/wasm": "^2.14.0",
    "@void/react": "1.1.11",
    "hono": "^4.13.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.2.0",
    "temporal-polyfill-lite": "^0.4.0",
    "transliteration": "^2.6.1",
    "void": "1.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260612.1",
    "@vitest/browser-playwright": "^5.0.3",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright": "^1.64.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.6.0"
  },
  "packageManager": "pnpm@11.6.0"
}
